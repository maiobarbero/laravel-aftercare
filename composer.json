{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "maio-barbero/laravel-aftercare",
    "description": "An opinionated starting configuration for Laravel, with Pint, PHPStan, Rector, and customizable application defaults.",
    "keywords": [
        "laravel",
        "defaults",
        "pint",
        "phpstan",
        "larastan",
        "rector"
    ],
    "homepage": "https://github.com/maio-barbero/laravel-aftercare",
    "license": "MIT",
    "authors": [
        {
            "name": "Matteo Barbero",
            "email": "matteo.barbero.m@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.8||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "MaioBarbero\\LaravelAftercare\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MaioBarbero\\LaravelAftercare\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "MaioBarbero\\LaravelAftercare\\AftercareServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
